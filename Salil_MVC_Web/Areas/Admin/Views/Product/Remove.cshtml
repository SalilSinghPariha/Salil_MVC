@model Product

<form method="post">
    <input hidden asp-for="@Model.Id" />
    <div class="border p-3 my-4">
        <div asp-validation-summary="ModelOnly"></div>
        <div class="mb-3 row p-1">
            <label>Title</label>
            <input asp-for="Title" type="text" class="form-control" disabled />
        </div>
        <div class="mb-3 row p-1">
            <label>Description</label>
            <input asp-for="Description" type="text" class="form-control" disabled />
        </div>
        <div class="mb-3 row p-1">
            <label>ISBN</label>
            <input asp-for="ISBN" type="text" class="form-control" disabled />
        </div>
        <div class="mb-3 row p-1">
            <label>Author</label>
            <input asp-for="Author" type="text" class="form-control" disabled />
        </div>
        <div class="mb-3 row p-1">
            <label>ListPrice</label>
            <input asp-for="ListPrice" type="text" class="form-control" disabled />
        </div>
        <div class="row">
            <div class="col-6">
                <button type="submit" asp-action="Remove" class="btn btn-primary form-control">Delete</button>
            </div>
            <div class="col-6">
                <a asp-controller="Product" asp-action="Index" class=" btn btn-outline-secondary form-control">
                    Back to List
                </a>
            </div>
        </div>
    </div>
</form>

@section Scripts{
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}
